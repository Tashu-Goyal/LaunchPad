# Leave DATABASE_URL unset locally to use SQLite (backend/launchpad.db).
# In production (Render), set this to your Neon PostgreSQL connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated list of allowed frontend origins for CORS in production:
# ALLOWED_ORIGINS=https://your-launchpad-app.vercel.app

# Optional regex for Vercel preview deployment URLs:
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
