# Leave DATABASE_URL unset locally to use SQLite (backend/launchpad.db).
# In Vercel production, set this in Project Settings -> Environment Variables
# to your Neon pooled PostgreSQL connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: only needed if you serve the frontend from a separate origin:
# ALLOWED_ORIGINS=https://your-launchpad-app.vercel.app
