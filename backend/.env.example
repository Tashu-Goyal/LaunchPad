# Leave DATABASE_URL unset locally to use SQLite (backend/launchpad.db).
#
# In Vercel production (or to test against Supabase locally), set DATABASE_URL
# using Supabase's Transaction Pooler (port 6543) or Session Pooler (port 5432)
# connection string from: Supabase Dashboard -> Connect -> Transaction pooler.
# Note: Never commit real passwords or .env files to Git.
#
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional: only needed if you serve the frontend from a separate origin:
# ALLOWED_ORIGINS=https://your-launchpad-app.vercel.app
