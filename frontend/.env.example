# Local development leaves this unset so Vite proxies /api -> http://127.0.0.1:8000.
# Single-project Vercel deployment also leaves this unset so the frontend uses
# same-origin /api/* routes handled by api/index.py via vercel.json.
# Only set VITE_API_BASE_URL if you ever host the backend on a separate domain:
# VITE_API_BASE_URL=https://your-separate-api.example.com/api
